# Notion integration token (Settings > Connections > Develop or manage integrations)
NOTION_TOKEN=
# ID of the Notion database that stores pre-registrations (shared with the integration above)
NOTION_PRE_REGISTER_DB_ID=

# New news database (separate from pre-registration)
NOTION_NEWS_DATA_SOURCE_ID=83793ee8-a696-468d-85ef-9d41e880b692
# Optional; defaults to NOTION_TOKEN
NOTION_NEWS_TOKEN=

# Public HTTPS origin; also used for Google callbacks and unsubscribe links.
NEXT_PUBLIC_SITE_URL=https://ritty.sam-meows.com

# Newsletter administrator login (server-only; exact comma-separated emails).
# Register: https://ritty.sam-meows.com/api/admin/newsletter/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEWSLETTER_ADMIN_EMAILS=
# Local development only: http://localhost:3000. Leave empty in production.
# Register that origin plus /api/admin/newsletter/auth/callback in Google OAuth.
# Keep NEXT_PUBLIC_SITE_URL on the public HTTPS site for email/unsubscribe links.
NEWSLETTER_AUTH_ORIGIN=
# Independent random value, at least 32 characters. Never use NEXT_PUBLIC_ for secrets.
NEWSLETTER_SESSION_SECRET=

# Stable random signing key, at least 32 characters; SAME value on web and worker.
# Rotation invalidates old unsubscribe links and pending campaign approvals.
MARKETING_UNSUBSCRIBE_SECRET=

# Separate PRIVATE Notion page shared with NOTION_TOKEN's integration.
# This is a page ID, not the contacts/news database. Do not publish it.
NEWSLETTER_QUEUE_PAGE_ID=

# Exact primary Workspace mailbox authorized by the Gmail setup helper.
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_SENDER_ACCOUNT=
NEWSLETTER_COMPANY_NAME=삼냥이즈 · Sam-Meows Inc.
# Company address and contact email: lib/newsletter-brand.ts

# Vercel only: fine-grained PAT, exact repository, Actions write permission.
NEWSLETTER_GITHUB_TOKEN=
NEWSLETTER_GITHUB_REPOSITORY=SamMeows/Ritty_Homepage
NEWSLETTER_GITHUB_REF=master

# Disabled until both web and GitHub Actions are configured. Set independently.
NEWSLETTER_ENABLED=false

# GitHub Actions secret / ignored local setup file ONLY. Do not put on Vercel.
# GOOGLE_REFRESH_TOKEN=
# Local OAuth helper only; default 53682. Register matching loopback callback.
# NEWSLETTER_OAUTH_PORT=53682
